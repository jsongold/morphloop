{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphloop.dev/contracts/schemas/events/payloads/learner_skill.updated/1.json",
  "title": "learner_skill.updated payload v1",
  "description": "The learner model's update result. Rebuild re-applies 'next' in position order without re-running the LLM (ADR-0013).",
  "type": "object",
  "required": [
    "pack_id",
    "skill_id",
    "previous",
    "next",
    "evidence_ids",
    "rationale",
    "predicted_success_probability",
    "provenance"
  ],
  "properties": {
    "pack_id": {
      "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/pack_id"
    },
    "skill_id": {
      "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/skill_id"
    },
    "previous": {
      "anyOf": [
        {
          "$ref": "https://morphloop.dev/contracts/schemas/common/skill-state.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "next": {
      "$ref": "https://morphloop.dev/contracts/schemas/common/skill-state.json"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/evidence_id"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "predicted_success_probability": {
      "description": "Predicted success on the next task (ADR-0011 calibration).",
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "provenance": {
      "$ref": "https://morphloop.dev/contracts/schemas/common/provenance.json#/$defs/llm"
    }
  },
  "additionalProperties": false
}
