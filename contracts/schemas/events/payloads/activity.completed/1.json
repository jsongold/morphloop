{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphloop.dev/contracts/schemas/events/payloads/activity.completed/1.json",
  "title": "activity.completed payload v1",
  "description": "The attempt ended with an outcome decided by its evaluation.",
  "type": "object",
  "required": [
    "outcome",
    "evaluation_id"
  ],
  "properties": {
    "outcome": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "evaluation_id": {
      "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/evaluation_id"
    }
  },
  "additionalProperties": false
}
