{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphloop.dev/contracts/schemas/events/payloads/terminal.output/1.json",
  "title": "terminal.output payload v1",
  "description": "One chunk of terminal output shown to the learner. Each chunk is its own event.",
  "type": "object",
  "required": [
    "terminal_id",
    "lab_instance_id",
    "sequence",
    "data",
    "encoding"
  ],
  "properties": {
    "terminal_id": {
      "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/terminal_id"
    },
    "lab_instance_id": {
      "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/lab_instance_id"
    },
    "sequence": {
      "description": "Display order within one terminal, shared with commands.",
      "type": "integer",
      "minimum": 0
    },
    "data": {
      "type": "string"
    },
    "encoding": {
      "enum": [
        "utf-8",
        "base64"
      ]
    }
  },
  "additionalProperties": false
}
