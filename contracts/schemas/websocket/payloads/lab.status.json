{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphloop.dev/contracts/schemas/websocket/payloads/lab.status.json",
  "title": "lab.status payload",
  "description": "Push when the lab instance behind this connection changes lifecycle state, e.g. after a reset (lab.reset) or a crash. 'terminal_id' is null until the lab has a terminal ready to accept input.",
  "type": "object",
  "required": [
    "lab_instance_id",
    "status",
    "terminal_id"
  ],
  "properties": {
    "lab_instance_id": {
      "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/lab_instance_id"
    },
    "status": {
      "enum": [
        "starting",
        "ready",
        "resetting",
        "stopped",
        "error"
      ]
    },
    "terminal_id": {
      "anyOf": [
        {
          "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/terminal_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "description": "Free-text detail, meaningful mainly when status is 'error'.",
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
