{
  "id": "dns-broken-resolver-lab",
  "type": "lab",
  "labels": ["topic:network.dns.resolution", "troubleshooting"],
  "spec": {
    "environment": {
      "id": "dns-broken-resolver-v1",
      "fixture": "dns.broken-resolver",
      "image": {
        "repository": "ghcr.io/morphloop/dns-lab",
        "digest": "sha256:3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f"
      },
      "params": {
        "fault": "wrong_nameserver",
        "service_name": "api.internal"
      }
    },
    "allowed_fixtures": ["dns.broken-resolver"],
    "allowed_checks": ["dns.name_resolves", "dns.command_exit"],
    "checks": [
      {"check": "dns.name_resolves", "params": {"name": "api.internal"}},
      {"check": "dns.command_exit", "params": {"argv": ["curl", "-fsS", "http://api.internal/"], "expected_exit_code": 0}}
    ]
  }
}
