{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphloop.dev/contracts/schemas/events/envelope/fields.json",
  "title": "Event envelope fields (open base)",
  "description": "Shared envelope fields. Not closed: validate against append.json or stored.json, never against this schema alone. The payload is checked by dispatch.json.",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "idempotency_key",
    "causation_id",
    "correlation_id",
    "learner_id",
    "session_id",
    "attempt_id",
    "activity_definition_id",
    "actor",
    "payload"
  ],
  "properties": {
    "event_id": {
      "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/event_id"
    },
    "event_type": {
      "description": "Dotted event type, e.g. 'terminal.command'.",
      "type": "string",
      "pattern": "^[a-z][a-z_]*(\\.[a-z][a-z_]*)+$"
    },
    "event_version": {
      "description": "Payload schema major version; payload schema is events/payloads/<event_type>/<event_version>.json.",
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "$ref": "https://morphloop.dev/contracts/schemas/common/timestamp.json"
    },
    "idempotency_key": {
      "anyOf": [
        {
          "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/idempotency_key"
        },
        {
          "type": "null"
        }
      ]
    },
    "causation_id": {
      "anyOf": [
        {
          "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/event_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlation_id": {
      "anyOf": [
        {
          "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/correlation_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "learner_id": {
      "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/learner_id"
    },
    "session_id": {
      "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/session_id"
    },
    "attempt_id": {
      "anyOf": [
        {
          "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/attempt_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "activity_definition_id": {
      "anyOf": [
        {
          "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/definition_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "actor": {
      "enum": [
        "learner",
        "tutor",
        "system"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "anyOf": [
    {
      "properties": {
        "attempt_id": {
          "type": "null"
        },
        "activity_definition_id": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "attempt_id": {
          "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/attempt_id"
        },
        "activity_definition_id": {
          "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/definition_id"
        }
      }
    }
  ]
}
