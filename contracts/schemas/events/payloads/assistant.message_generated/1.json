{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphloop.dev/contracts/schemas/events/payloads/assistant.message_generated/1.json",
  "title": "assistant.message_generated payload v1",
  "description": "The tutor's reply as shown to the learner.",
  "type": "object",
  "required": [
    "message_id",
    "thread_id",
    "in_reply_to",
    "text",
    "mode",
    "references",
    "provenance"
  ],
  "properties": {
    "message_id": {
      "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/message_id"
    },
    "thread_id": {
      "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/thread_id"
    },
    "in_reply_to": {
      "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/message_id"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/token"
    },
    "references": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "title": "Highlight reference",
            "type": "object",
            "required": [
              "type",
              "id"
            ],
            "properties": {
              "type": {
                "const": "highlight"
              },
              "id": {
                "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/highlight_id"
              }
            },
            "additionalProperties": false
          },
          {
            "title": "Event reference",
            "type": "object",
            "required": [
              "type",
              "id"
            ],
            "properties": {
              "type": {
                "const": "event"
              },
              "id": {
                "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/event_id"
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "provenance": {
      "$ref": "https://morphloop.dev/contracts/schemas/common/provenance.json#/$defs/llm"
    }
  },
  "additionalProperties": false
}
