{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphloop.dev/contracts/schemas/events/payloads/evaluation.failed/1.json",
  "title": "evaluation.failed payload v1",
  "description": "The evaluation chain of a submission failed before anything was recorded (AC-E4). The attempt returns to active with this problem as last_submission_error; no learner state changed.",
  "type": "object",
  "required": [
    "submission_event_id",
    "problem"
  ],
  "properties": {
    "submission_event_id": {
      "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/event_id"
    },
    "problem": {
      "description": "RFC 9457 problem details, as the HTTP Problem schema.",
      "type": "object",
      "required": [
        "type",
        "title",
        "status",
        "code"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z-]*$"
        },
        "detail": {
          "type": "string"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "message"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
