{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphloop.dev/contracts/schemas/events/payloads/evaluation.completed/1.json",
  "title": "evaluation.completed payload v1",
  "description": "An Evaluation finished: deterministic check observations plus the overall judgment.",
  "type": "object",
  "required": [
    "evaluation_id",
    "evaluator",
    "lab_instance_id",
    "checks",
    "success",
    "rationale",
    "provenance"
  ],
  "properties": {
    "evaluation_id": {
      "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/evaluation_id"
    },
    "evaluator": {
      "$ref": "https://morphloop.dev/contracts/schemas/common/provenance.json#/$defs/definition_ref"
    },
    "lab_instance_id": {
      "anyOf": [
        {
          "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/lab_instance_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "checks": {
      "description": "Deterministic observations (ADR-0013); never LLM-produced.",
      "type": "array",
      "items": {
        "title": "Check result",
        "type": "object",
        "required": [
          "check_id",
          "passed",
          "observed"
        ],
        "properties": {
          "check_id": {
            "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/adapter_item_id"
          },
          "passed": {
            "type": "boolean"
          },
          "observed": {
            "description": "Adapter-defined observed facts; opaque to core.",
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "success": {
      "type": "boolean"
    },
    "rationale": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance": {
      "description": "LLM provenance when an LLM evaluator was used, else null.",
      "anyOf": [
        {
          "$ref": "https://morphloop.dev/contracts/schemas/common/provenance.json#/$defs/llm"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false
}
