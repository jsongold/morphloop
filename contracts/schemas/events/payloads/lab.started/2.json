{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphloop.dev/contracts/schemas/events/payloads/lab.started/2.json",
  "title": "lab.started payload v2",
  "description": "A LabInstance started for the attempt (initially or after a reset). v2 adds runtime_ref so a restarted process can reattach a terminal (v1 events upcast with runtime_ref null).",
  "type": "object",
  "required": [
    "lab_instance_id",
    "environment",
    "trigger",
    "replaces_lab_instance_id",
    "provenance",
    "runtime_ref"
  ],
  "properties": {
    "lab_instance_id": {
      "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/lab_instance_id"
    },
    "environment": {
      "$ref": "https://morphloop.dev/contracts/schemas/common/provenance.json#/$defs/definition_ref"
    },
    "trigger": {
      "enum": [
        "initial",
        "reset"
      ]
    },
    "replaces_lab_instance_id": {
      "anyOf": [
        {
          "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/lab_instance_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance": {
      "$ref": "https://morphloop.dev/contracts/schemas/common/provenance.json#/$defs/lab"
    },
    "runtime_ref": {
      "description": "Opaque lab runtime handle (LabInfo.runtime_ref, e.g. a container id); only handed back to the paired terminal bridge adapter.",
      "type": "string",
      "pattern": "^[\\x21-\\x7e]{1,255}$"
    }
  },
  "additionalProperties": false
}
