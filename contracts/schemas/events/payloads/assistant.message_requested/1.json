{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphloop.dev/contracts/schemas/events/payloads/assistant.message_requested/1.json",
  "title": "assistant.message_requested payload v1",
  "description": "The learner sent a chat message to the tutor, optionally quoting highlights/events.",
  "type": "object",
  "required": [
    "message_id",
    "thread_id",
    "text",
    "references"
  ],
  "properties": {
    "message_id": {
      "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/message_id"
    },
    "thread_id": {
      "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/thread_id"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "requested_mode": {
      "description": "Reply mode the learner asked for (e.g. hint, explain), or null to let the harness choose. The harness decides the final mode, recorded on assistant.message_generated, and may override the request, e.g. keep hint mode during an unfinished attempt (AC-E3). Allowed values are declared by the pack.",
      "anyOf": [
        {
          "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/token"
        },
        {
          "type": "null"
        }
      ]
    },
    "references": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "title": "Highlight reference",
            "type": "object",
            "required": [
              "type",
              "id"
            ],
            "properties": {
              "type": {
                "const": "highlight"
              },
              "id": {
                "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/highlight_id"
              }
            },
            "additionalProperties": false
          },
          {
            "title": "Event reference",
            "type": "object",
            "required": [
              "type",
              "id"
            ],
            "properties": {
              "type": {
                "const": "event"
              },
              "id": {
                "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/event_id"
              }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
