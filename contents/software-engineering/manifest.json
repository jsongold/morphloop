{
  "pack_format": 1,
  "pack_id": "software-engineering",
  "pack_version": "0.1.0",
  "title": "Software Engineering Fundamentals",
  "description": "Hands-on troubleshooting practice for software engineers. v0.1 covers DNS name resolution: a broken-resolver lab, an abstraction-to-reality visualization of the lookup path, short concept references, and the LLM tutor, evaluator and learner-model configuration tuned for this content.",
  "domain_adapters": {
    "dns": ">=0.1.0,<0.2.0"
  },
  "registry": {
    "learner_model": {
      "implementation": "llm-learner-model@0.1.0",
      "llm": {
        "provider": "openai",
        "model": "gpt-5.4-2026-03-05",
        "prompt_id": "learner-model-update",
        "prompt_version": "1",
        "generation_parameters": {
          "max_tokens": 16000,
          "reasoning_effort": "high"
        }
      },
      "output_schema": "https://morphloop.dev/contracts/schemas/llm/learner_model.update/1.json",
      "context_budget_tokens": 16000,
      "options": {
        "max_mastery_delta": 0.3
      }
    },
    "evaluator": {
      "implementation": "llm-evaluator@0.1.0",
      "llm": {
        "provider": "openai",
        "model": "gpt-5.4-2026-03-05",
        "prompt_id": "evaluator-judgment",
        "prompt_version": "1",
        "generation_parameters": {
          "max_tokens": 16000,
          "reasoning_effort": "high"
        }
      },
      "output_schema": "https://morphloop.dev/contracts/schemas/llm/evaluator.judgment/1.json",
      "context_budget_tokens": 48000,
      "options": {
        "include_reference_solution": true
      }
    },
    "tutor": {
      "implementation": "llm-tutor@0.1.0",
      "llm": {
        "provider": "openai",
        "model": "gpt-5.4-2026-03-05",
        "prompt_id": "tutor-reply",
        "prompt_version": "1",
        "generation_parameters": {
          "max_tokens": 4000,
          "reasoning_effort": "medium"
        }
      },
      "output_schema": "https://morphloop.dev/contracts/schemas/llm/tutor.reply/1.json",
      "context_budget_tokens": 24000,
      "options": {
        "modes": [
          "hint",
          "explain",
          "review"
        ],
        "default_mode_unfinished_attempt": "hint",
        "default_mode_finished_attempt": "review",
        "modes_allowed_unfinished_attempt": [
          "hint",
          "explain"
        ],
        "recent_events_limit": 30
      }
    },
    "generator": {
      "implementation": "llm-generator@0.1.0",
      "llm": {
        "provider": "openai",
        "model": "gpt-5.4-2026-03-05",
        "prompt_id": "activity-generation",
        "prompt_version": "1",
        "generation_parameters": {
          "max_tokens": 32000,
          "reasoning_effort": "high"
        }
      },
      "output_schema": "https://morphloop.dev/contracts/schemas/llm/generator.activity_candidate/1.json",
      "context_budget_tokens": 16000,
      "options": {}
    }
  },
  "content_generation": {
    "default_timing": "authoring",
    "max_regenerations": 3
  },
  "files": {
    "activities/gen-diagnose-dns-resolver-misconfiguration-001.generation.json": {
      "kind": "generation_record"
    },
    "activities/gen-diagnose-dns-resolver-misconfiguration-001.json": {
      "kind": "activity"
    },
    "activities/gen-diagnose-dns-resolver-misconfiguration-001.solution.json": {
      "kind": "reference_solution"
    },
    "environments/gen-diagnose-dns-resolver-misconfiguration-001.json": {
      "kind": "environment"
    },
    "evaluators/dns-diagnosis-v1.json": {
      "kind": "evaluator"
    },
    "prompts/activity-generation.md": {
      "kind": "prompt",
      "prompt_id": "activity-generation",
      "prompt_version": "1"
    },
    "prompts/evaluator-judgment.md": {
      "kind": "prompt",
      "prompt_id": "evaluator-judgment",
      "prompt_version": "1"
    },
    "prompts/learner-model-update.md": {
      "kind": "prompt",
      "prompt_id": "learner-model-update",
      "prompt_version": "1"
    },
    "prompts/tutor-reply.md": {
      "kind": "prompt",
      "prompt_id": "tutor-reply",
      "prompt_version": "1"
    },
    "references/network.dns.answers.json": {
      "kind": "reference"
    },
    "references/network.dns.lookup-path.json": {
      "kind": "reference"
    },
    "references/network.dns.resolver.json": {
      "kind": "reference"
    },
    "skills/network.dns.resolution.json": {
      "kind": "skill"
    },
    "templates/diagnose-dns-resolver-misconfiguration.json": {
      "kind": "activity_template"
    },
    "ux/layout.json": {
      "kind": "layout"
    },
    "visualizations/dns-resolution-flow.json": {
      "kind": "visualization"
    }
  }
}
