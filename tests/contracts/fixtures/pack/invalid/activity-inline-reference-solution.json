{
  "description": "The reference solution is a separate document bound by path + hash, never inline (AC-J6).",
  "schema": "schemas/pack/activity-definition.json",
  "expected_error_paths": [
    "$.reference_solution"
  ],
  "instance": {
    "id": "diagnose-dns-resolver-failure-v1",
    "title": "api.internal cannot be reached by name",
    "activity_type": "diagnose",
    "skills": {
      "primary": [
        "network.dns.resolution"
      ]
    },
    "difficulty": 0.5,
    "origin": {
      "type": "authored"
    },
    "instructions": {
      "mission": "`api.internal` cannot be reached by name, but the service may still be running. Diagnose the failure and restore connectivity."
    },
    "hints": [
      "Can you reach the service by IP address?",
      "Which server does this host ask for names?"
    ],
    "environment": "dns-broken-resolver-v1",
    "tools": [
      "dns.terminal"
    ],
    "checks": [
      {
        "check": "dns.name_resolves",
        "params": {
          "name": "api.internal"
        }
      },
      {
        "check": "dns.command_exit",
        "params": {
          "argv": [
            "curl",
            "-fsS",
            "http://api.internal/health"
          ],
          "expected_exit_code": 0
        }
      }
    ],
    "evaluator": "dns-diagnosis-v1",
    "reference_solution": {
      "id": "diagnose-dns-resolver-failure-v1.solution",
      "activity_id": "diagnose-dns-resolver-failure-v1",
      "apply": [
        {
          "argv": [
            "cp",
            "/opt/lab/resolv.conf.good",
            "/etc/resolv.conf"
          ],
          "timeout_seconds": 10
        }
      ],
      "explanation": "/etc/resolv.conf points at an address with no DNS server. Restoring the lab resolver makes api.internal resolve again."
    },
    "remediation": {
      "references": [
        "network.dns.resolver"
      ],
      "visualizations": [
        "dns-resolution-flow"
      ]
    }
  }
}
