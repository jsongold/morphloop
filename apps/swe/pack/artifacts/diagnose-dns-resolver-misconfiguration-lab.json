{
  "id": "diagnose-dns-resolver-misconfiguration-lab",
  "type": "lab",
  "labels": [
    "topic:network.dns.resolution",
    "troubleshooting"
  ],
  "spec": {
    "environment": {
      "id": "gen-diagnose-dns-resolver-misconfiguration-001.env",
      "fixture": "dns.resolver_lab",
      "image": {
        "repository": "docker.io/nicolaka/netshoot",
        "digest": "sha256:7f08c4aff13ff61a35d30e30c5c1ea8396eac6ab4ce19fd02d5a4b3b5d0d09a2"
      },
      "params": {
        "zone": "corp.internal",
        "service_name": "ledger.corp.internal",
        "service_address": "127.0.0.42",
        "service_port": 9093,
        "health_path": "/readyz",
        "dns_server_address": "127.0.0.53",
        "record_ttl_seconds": 30,
        "resolver_timeout_seconds": 1,
        "resolver_attempts": 1,
        "fault": "wrong_nameserver",
        "configured_nameserver": "203.0.113.77"
      }
    },
    "allowed_fixtures": [
      "dns.resolver_lab"
    ],
    "allowed_checks": [
      "dns.resolver_answers",
      "dns.name_resolves",
      "dns.http_status"
    ],
    "checks": [
      {
        "check": "dns.resolver_answers",
        "params": {"name": "ledger.corp.internal", "record_type": "A", "expected_value": "127.0.0.42"}
      },
      {
        "check": "dns.name_resolves",
        "params": {"name": "ledger.corp.internal", "expected_address": "127.0.0.42"}
      },
      {
        "check": "dns.http_status",
        "params": {"url": "http://ledger.corp.internal:9093/readyz", "expected_status": 200}
      }
    ],
    "idle_seconds": 1800
  }
}
