{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphloop.dev/contracts/schemas/events/payloads/evidence.created/1.json",
  "title": "evidence.created payload v1",
  "description": "One Evidence item produced by an Evaluation (cause: evaluation.completed).",
  "type": "object",
  "required": [
    "evidence_id",
    "evaluation_id",
    "skill_id",
    "signal",
    "strength",
    "dimension",
    "rationale",
    "supporting_event_ids"
  ],
  "properties": {
    "evidence_id": {
      "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/evidence_id"
    },
    "evaluation_id": {
      "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/evaluation_id"
    },
    "skill_id": {
      "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/skill_id"
    },
    "signal": {
      "enum": [
        "positive",
        "negative"
      ]
    },
    "strength": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "dimension": {
      "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/token"
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "supporting_event_ids": {
      "description": "Events (commands, outputs, hints...) this evidence rests on.",
      "type": "array",
      "items": {
        "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/event_id"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
