# Dependency-direction contracts for AC-G1 (see docs/decisions/0009-extension-boundary.md,
# 0015, 0017). Enforces the extension boundary described in CLAUDE.md:
#   harness.core            -- domain-agnostic core; must not import adapters/api/cli/testing/domains.
#   harness.adapters.*      -- one technical adapter per library; must not import each other,
#                               nor harness.api/harness.cli/domains.
#   domains.*               -- domain adapter layer; must not import harness.adapters/api/cli.
#   harness.api / harness.cli -- wiring layer; may import everything, so no contract restricts it.
#   apps.*                  -- apps built on the SDK (ADR-0018 s19); harness never imports them.
#                               `apps` is a directory, not a package: each app is its own root
#                               package (`swe`), and the `apps` name is matched as an external
#                               package (include_external_packages) so a stray `import apps` fails.
#
# The pack (contents/<pack-id>/) is pure data and is never imported by Python code, so it is
# not, and cannot be, a node in this graph.
[importlinter]
include_external_packages = True
root_packages =
    harness
    domains
    swe

[importlinter:contract:core-is-domain-agnostic]
name = harness.core must not import adapters, api, cli, testing or domains
type = forbidden
source_modules =
    harness.core
forbidden_modules =
    harness.adapters
    harness.api
    harness.cli
    harness.testing
    domains

[importlinter:contract:adapters-are-independent]
name = harness.adapters.* libraries must not import each other
type = independence
modules =
    harness.adapters.postgres
    harness.adapters.litellm
    harness.adapters.docker_lab
    harness.adapters.pty

[importlinter:contract:adapters-do-not-import-wiring-or-domains]
name = harness.adapters.* must not import api, cli or domains
type = forbidden
source_modules =
    harness.adapters
forbidden_modules =
    harness.api
    harness.cli
    domains

[importlinter:contract:domains-do-not-import-adapters-or-wiring]
name = domains.* must not import harness.adapters, harness.api or harness.cli
type = forbidden
source_modules =
    domains
forbidden_modules =
    harness.adapters
    harness.api
    harness.cli

# v0.2 resources (#34, #48): harness.core.<resource> packages never import each other; they
# refer to each other by id. `harness.core.*` covers every new resource package automatically.
# Allowed shared imports are the Ports, contract schemas, settings, the pack loader, the domain
# adapter base and the v0.2 bases (view / artifact / labels). Notebook is the
# function layer and may compose resources (#66).
[importlinter:contract:core-resources-are-independent]
name = harness.core.<resource> packages must not import each other
type = independence
modules =
    harness.core.*
ignore_imports =
    harness.core.** -> harness.core.ports
    harness.core.** -> harness.core.ports.**
    harness.core.** -> harness.core.contract_schemas
    harness.core.** -> harness.core.settings
    harness.core.** -> harness.core.pack
    harness.core.** -> harness.core.pack.**
    harness.core.** -> harness.core.domain_adapter
    harness.core.** -> harness.core.view
    harness.core.** -> harness.core.artifact
    harness.core.** -> harness.core.labels
    harness.core.notebook.** -> harness.core.textbook.**
    harness.core.notebook.** -> harness.core.drill.**
    harness.core.notebook.** -> harness.core.memo.**
    harness.core.notebook.** -> harness.core.ws.**
    harness.core.notebook.** -> harness.core.session.**
unmatched_ignore_imports_alerting = none

[importlinter:contract:harness-does-not-import-apps]
name = harness must not import apps
type = forbidden
source_modules =
    harness
    domains
forbidden_modules =
    apps
    swe

# Apps (ADR-0018 s19): `swe` (apps/swe/, a workspace member installed by the dev group)
# depends on the SDK through its public API only, so it can move to its own repository
# unchanged. `domains.dns` is SWE code that still lives here for the v0.1 loop; it moves
# into apps/swe with #69, so that one import is allowed until then.
[importlinter:contract:apps-import-only-the-sdk-api]
name = swe must import harness.sdk only (plus domains.dns until #69)
type = forbidden
source_modules =
    swe
forbidden_modules =
    harness
    domains
ignore_imports =
    swe.** -> harness.sdk
    swe.** -> domains.dns
unmatched_ignore_imports_alerting = none
