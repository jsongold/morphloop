{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphloop.dev/contracts/schemas/pack/generation-record.json",
  "title": "Generation record (authoring)",
  "description": "Minimal in-house record placed next to the files produced by one 'authoring' generation run (ADR-0016 section 6; AC-J7). Not a learning event: 'authoring' runs from a CLI with no learner or session. Runtime timings ('pooled', 'just_in_time') record the same facts as events instead (v0.2+). Only a run that passed validation produces files, so validation.outcome is always 'passed'; rejected candidates are summarized without their content. Withheld from the learner and the tutor context.",
  "type": "object",
  "required": [
    "timing",
    "template",
    "generator",
    "generated_at",
    "outputs",
    "validation",
    "rejected_candidates"
  ],
  "properties": {
    "timing": {
      "const": "authoring"
    },
    "template": {
      "type": "object",
      "required": [
        "template_id",
        "template_hash"
      ],
      "properties": {
        "template_id": {
          "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/definition_id"
        },
        "template_hash": {
          "$ref": "https://morphloop.dev/contracts/schemas/pack/defs.json#/$defs/document_hash"
        }
      },
      "additionalProperties": false
    },
    "generator": {
      "type": "object",
      "required": [
        "implementation",
        "llm"
      ],
      "properties": {
        "implementation": {
          "$ref": "https://morphloop.dev/contracts/schemas/common/versions.json#/$defs/name_at_version"
        },
        "llm": {
          "$ref": "https://morphloop.dev/contracts/schemas/common/provenance.json#/$defs/llm"
        }
      },
      "additionalProperties": false
    },
    "generated_at": {
      "$ref": "https://morphloop.dev/contracts/schemas/common/timestamp.json"
    },
    "outputs": {
      "description": "Finalized Definition files written by this run, with their document hashes. Exactly one activity.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "path",
          "definition_id",
          "definition_hash"
        ],
        "properties": {
          "kind": {
            "enum": [
              "activity",
              "environment",
              "reference_solution",
              "visualization"
            ]
          },
          "path": {
            "$ref": "https://morphloop.dev/contracts/schemas/pack/defs.json#/$defs/relative_path"
          },
          "definition_id": {
            "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/definition_id"
          },
          "definition_hash": {
            "$ref": "https://morphloop.dev/contracts/schemas/pack/defs.json#/$defs/document_hash"
          }
        },
        "additionalProperties": false
      },
      "contains": {
        "properties": {
          "kind": {
            "const": "activity"
          }
        }
      },
      "minContains": 1,
      "maxContains": 1
    },
    "validation": {
      "type": "object",
      "required": [
        "outcome",
        "steps"
      ],
      "properties": {
        "outcome": {
          "const": "passed"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/validation_step"
          },
          "allOf": [
            {
              "contains": {
                "properties": {
                  "step": {
                    "const": "schema"
                  }
                }
              }
            },
            {
              "contains": {
                "properties": {
                  "step": {
                    "const": "adapter_references"
                  }
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "rejected_candidates": {
      "description": "Candidates that failed validation before the accepted one, in order. May be empty.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "attempt",
          "failed_step",
          "reason"
        ],
        "properties": {
          "attempt": {
            "type": "integer",
            "minimum": 1
          },
          "failed_step": {
            "$ref": "#/$defs/step_name"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "if": {
    "properties": {
      "outputs": {
        "contains": {
          "properties": {
            "kind": {
              "const": "environment"
            }
          }
        }
      }
    }
  },
  "then": {
    "description": "A lab-backed output must have passed both lab steps (AC-J2).",
    "properties": {
      "validation": {
        "properties": {
          "steps": {
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "step": {
                      "const": "checks_fail_in_broken_state"
                    }
                  }
                }
              },
              {
                "contains": {
                  "properties": {
                    "step": {
                      "const": "checks_pass_after_solution"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "step_name": {
      "enum": [
        "schema",
        "adapter_references",
        "checks_fail_in_broken_state",
        "checks_pass_after_solution"
      ]
    },
    "validation_step": {
      "type": "object",
      "required": [
        "step",
        "outcome",
        "lab"
      ],
      "properties": {
        "step": {
          "$ref": "#/$defs/step_name"
        },
        "outcome": {
          "const": "passed"
        },
        "lab": {
          "description": "Lab provenance for lab steps; null otherwise.",
          "anyOf": [
            {
              "$ref": "https://morphloop.dev/contracts/schemas/common/provenance.json#/$defs/lab"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
