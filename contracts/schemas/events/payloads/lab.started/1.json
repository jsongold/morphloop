{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphloop.dev/contracts/schemas/events/payloads/lab.started/1.json",
  "title": "lab.started payload v1",
  "description": "A LabInstance started for the attempt (initially or after a reset).",
  "type": "object",
  "required": [
    "lab_instance_id",
    "environment",
    "trigger",
    "replaces_lab_instance_id",
    "provenance"
  ],
  "properties": {
    "lab_instance_id": {
      "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/lab_instance_id"
    },
    "environment": {
      "$ref": "https://morphloop.dev/contracts/schemas/common/provenance.json#/$defs/definition_ref"
    },
    "trigger": {
      "enum": [
        "initial",
        "reset"
      ]
    },
    "replaces_lab_instance_id": {
      "anyOf": [
        {
          "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/lab_instance_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance": {
      "$ref": "https://morphloop.dev/contracts/schemas/common/provenance.json#/$defs/lab"
    }
  },
  "additionalProperties": false
}
