{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphloop.dev/contracts/schemas/events/payloads/content.highlighted/2.json",
  "title": "content.highlighted payload v2",
  "description": "The learner created a persistent highlight. v2 adds 'source' so text outside pack content can be highlighted: a chat message (learner or tutor) or terminal output. v1 upcasts to v2 as source {kind: pack, content_id, content_version}. Offsets are UTF-16 code-unit offsets into the source text (pack document text, or chat message 'text'); they are null only for terminal sources, where the rendered buffer has no stable offset and selected_text + context are the anchor. Every highlight owns one popup thread (thread_id 'thr_' + the highlight_id tail) and at most one memo ('memo_' + the same tail).",
  "type": "object",
  "required": [
    "highlight_id",
    "source",
    "selected_text",
    "start_offset",
    "end_offset",
    "semantic_anchor",
    "context_before",
    "context_after"
  ],
  "properties": {
    "highlight_id": {
      "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/highlight_id"
    },
    "source": {
      "oneOf": [
        {
          "title": "Pack content (mission, reference, skill, visualization)",
          "type": "object",
          "required": ["kind", "content_id", "content_version"],
          "properties": {
            "kind": { "const": "pack" },
            "content_id": {
              "$ref": "https://morphloop.dev/contracts/schemas/events/payloads/content.highlighted/1.json#/properties/content_id"
            },
            "content_version": {
              "$ref": "https://morphloop.dev/contracts/schemas/events/payloads/content.highlighted/1.json#/properties/content_version"
            }
          },
          "additionalProperties": false
        },
        {
          "title": "Chat message (learner message or tutor reply)",
          "description": "Offsets index the message's 'text'. The message must belong to the session.",
          "type": "object",
          "required": ["kind", "message_id"],
          "properties": {
            "kind": { "const": "chat_message" },
            "message_id": {
              "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/message_id"
            }
          },
          "additionalProperties": false
        },
        {
          "title": "Terminal output",
          "description": "Inclusive range of terminal.output 'sequence' values the selection spans, as seen by the client (ws terminal.output carries 'sequence').",
          "type": "object",
          "required": ["kind", "terminal_id", "first_sequence", "last_sequence"],
          "properties": {
            "kind": { "const": "terminal" },
            "terminal_id": {
              "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/terminal_id"
            },
            "first_sequence": { "type": "integer", "minimum": 0 },
            "last_sequence": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      ]
    },
    "selected_text": {
      "type": "string",
      "minLength": 1
    },
    "start_offset": {
      "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
    },
    "end_offset": {
      "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
    },
    "semantic_anchor": {
      "$ref": "https://morphloop.dev/contracts/schemas/events/payloads/content.highlighted/1.json#/properties/semantic_anchor"
    },
    "context_before": {
      "type": "string"
    },
    "context_after": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "if": {
    "properties": { "source": { "properties": { "kind": { "const": "terminal" } } } }
  },
  "then": {
    "properties": { "start_offset": { "type": "null" }, "end_offset": { "type": "null" } }
  },
  "else": {
    "properties": { "start_offset": { "type": "integer" }, "end_offset": { "type": "integer" } }
  }
}
