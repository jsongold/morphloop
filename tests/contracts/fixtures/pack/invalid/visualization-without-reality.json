{
  "description": "At least one step maps to reality with an executable observation (AC-C2).",
  "schema": "schemas/pack/visualization.json",
  "expected_error_paths": [
    "$.diagram.steps"
  ],
  "instance": {
    "id": "dns-resolution-flow",
    "version": "1",
    "title": "How api.internal becomes an address",
    "skills": [
      "network.dns.resolution"
    ],
    "diagram": {
      "type": "sequence",
      "actors": [
        {
          "id": "app",
          "label": "Application"
        },
        {
          "id": "stub",
          "label": "OS stub resolver"
        },
        {
          "id": "recursive",
          "label": "Recursive resolver"
        },
        {
          "id": "authoritative",
          "label": "Authoritative server"
        }
      ],
      "steps": [
        {
          "id": "lookup",
          "from": "app",
          "to": "stub",
          "label": "getaddrinfo(api.internal)"
        },
        {
          "id": "query",
          "from": "stub",
          "to": "recursive",
          "label": "DNS query (UDP 53)",
          "explanation": "The stub resolver asks the nameserver listed in its configuration."
        },
        {
          "id": "authority",
          "from": "recursive",
          "to": "authoritative",
          "label": "Ask the zone's server"
        }
      ]
    }
  }
}
