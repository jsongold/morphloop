{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphloop.dev/contracts/schemas/common/skill-state.json",
  "title": "Learner skill state",
  "description": "Per-skill learner state produced by the learner model and re-applied by rebuild (ADR-0013). Counters and timestamps are derived by the projection, not stored here.",
  "type": "object",
  "required": [
    "mastery_probability",
    "uncertainty"
  ],
  "properties": {
    "mastery_probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "uncertainty": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "retention_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "transfer_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "hint_dependency": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "misconceptions": {
      "type": "array",
      "items": {
        "$ref": "https://morphloop.dev/contracts/schemas/common/ids.json#/$defs/token"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
